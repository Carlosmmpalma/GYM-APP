rules_version = '2';

// Fase 1 — isolamento entre tenants (Platform Foundation §7).
// Fase 2 — regras específicas de booking (contador de vagas + ownership).
//
// A matriz fina de autorização por role (o que um Instructor pode
// fazer vs. um Manager, etc.) continua a ser trabalho do documento
// "06 — Security & Business Rules" e das fases 3+. Até lá, dentro do
// próprio tenant, qualquer utilizador autenticado tem leitura/escrita
// ampla — EXCETO em sessionOccurrences/bookings, onde a Fase 2 exige
// regras mais apertadas (não dá para ter aqui uma regra ampla que
// cubra tudo: no Firestore, se QUALQUER regra que faça match permitir
// a operação, ela é permitida — por isso sessionOccurrences/bookings
// têm de ficar FORA do wildcard genérico, não só "sobrepostas" por uma
// regra mais restrita).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function belongsToTenant(tenantId) {
      return isSignedIn() && request.auth.token.tenantId == tenantId;
    }

    // Fase 3 — primeira regra que distingue Manager de outros roles.
    // `roles` é um array nos custom claims (mesmo formato usado pelo
    // `requireManager()` das Cloud Functions — ver
    // `firebase/functions/src/lib/callerContext.ts`), por isso o
    // próprio token já traz esta informação sem precisar de nenhum
    // `get()` extra a Firestore.
    function isManager(tenantId) {
      return belongsToTenant(tenantId) && 'manager' in request.auth.token.roles;
    }

    // Fase 6 — presença (UC10-A) pode ser registada por Instrutor OU
    // Manager, ao contrário das ações de gestão anteriores
    // (Planos/Serviços/Modalidades/Séries), que continuam Manager-only.
    function isInstructor(tenantId) {
      return belongsToTenant(tenantId) && 'instructor' in request.auth.token.roles;
    }

    // Fase 11 — um instrutor pode criar/alterar ESTA aula?
    //
    // Duas condições, e as duas importam:
    //
    //  1. A aula tem de ser **dele** (`instructorId == uid`). Sem isto,
    //     um instrutor punha aulas no horário em nome de um colega.
    //  2. O serviço tem de estar na lista de serviços que o Gestor lhe
    //     associou (`staff/{uid}.serviceIds`). Sem isto, quem dá
    //     Pilates criava aulas de Hyrox.
    //
    // A lista vive no documento de staff, que só o Gestor escreve — é
    // ele quem decide o que cada instrutor pode lecionar. Um instrutor
    // sem serviços associados não cria aulas nenhumas, que é o valor
    // por omissão de propósito.
    //
    // Custa um `get()` por escrita. Criar ou ajustar uma aula é raro
    // (não é caminho quente), e a alternativa — confiar no cliente —
    // não é alternativa nenhuma.
    function instructorOwnsSession(tenantId, data) {
      let staffPath = /databases/$(database)/documents/tenants/$(tenantId)/staff/$(request.auth.uid);
      return isInstructor(tenantId)
        && data.get('instructorId', '') == request.auth.uid
        && exists(staffPath)
        && data.get('serviceId', '') in get(staffPath).data.get('serviceIds', []);
    }

    // Fase 11 (RGPD, artigo 9.º) — este membro autorizou explicitamente
    // o tratamento de dados de saúde?
    //
    // Avaliações físicas e histórico de carga são dados de saúde:
    // pressão arterial, percentagem de massa gorda, gordura visceral. O
    // artigo 9.º proíbe tratá-los sem consentimento explícito, e o
    // artigo 7.º, n.º 4 diz que o consentimento não é livre se for
    // condição de um serviço que dele não depende — daí ser opcional e
    // separado da aceitação da política de privacidade.
    //
    // A verificação vive AQUI e não só na UI de propósito: esconder o
    // botão de "nova avaliação" não impede uma escrita direta, e é
    // exatamente contra isso que uma autoridade de proteção de dados
    // quereria garantias. Custa um `get()` por escrita — avaliações são
    // raras (uma cada poucas semanas por aluno), não é caminho quente.
    //
    // `exists()` antes do `get()` pela mesma razão de
    // `freeTrainingWeekPublished` — um `get()` a documento inexistente
    // é um erro de avaliação, não um `false`. E `'consent' in` antes de
    // aceder ao campo: sem isso, um membro criado antes de existir
    // consentimento fazia a regra rebentar em vez de recusar
    // (apanhado pela suite de testes, não à vista).
    function hasHealthDataConsent(tenantId, memberId) {
      let path = /databases/$(database)/documents/tenants/$(tenantId)/members/$(memberId);
      return exists(path)
        && 'consent' in get(path).data
        && get(path).data.consent.get('healthDataGranted', false) == true;
    }

    // Fase 10 (bug reportado) — a semana de treino livre está publicada?
    //
    // `get()` a um documento que NÃO existe não devolve algo que se
    // possa comparar com null: a expressão inteira falha com um ERRO de
    // avaliação, e o cliente recebe `permission-denied` ("Null value
    // error for 'get'") em vez de "não existe". Efeito prático: um Aluno
    // que abrisse "Treino livre" numa semana ainda sem grelha via um
    // erro de permissões no ecrã em vez do estado vazio. Daí o
    // `exists()` primeiro — custa uma leitura extra quando o documento
    // existe, e é a única forma de a regra dar `false` em vez de rebentar.
    function freeTrainingWeekPublished(tenantId, weekId) {
      return exists(/databases/$(database)/documents/tenants/$(tenantId)/freeTrainingSchedules/$(weekId))
        && get(/databases/$(database)/documents/tenants/$(tenantId)/freeTrainingSchedules/$(weekId)).data.status == 'published';
    }


    // --- Dados de configuração/identidade do tenant (Fase 1) ---
    // Leitura/escrita ampla para qualquer utilizador do próprio tenant.
    // Ver nota no topo do ficheiro sobre porque isto não pode incluir
    // sessionOccurrences/bookings.

    // Fase 8 (revisão geral) — escrita passou a Manager. O documento do
    // tenant guarda `name`/`timezone`/`status`; com a regra antiga,
    // qualquer aluno podia renomear o ginásio ou pôr o tenant a
    // `suspended`. Nenhum ecrã de cliente escreve aqui (o seed usa o
    // Admin SDK, que ignora Rules), por isso apertar não parte nada.
    match /tenants/{tenantId} {
      allow read: if belongsToTenant(tenantId);
      allow write: if isManager(tenantId);
    }

    // Fase 5 (UC02) — até aqui, `allow read, write: if belongsToTenant`
    // deixava QUALQUER membro autenticado do tenant escrever no
    // documento de QUALQUER OUTRO membro (incluindo `memberNumber`/
    // `status`) — nunca explorado por nenhum ecrã, mas uma lacuna real
    // de autorização, não só de UI. Escrita ampla continua só para
    // Manager; o próprio membro só pode atualizar `phone`/`email` no
    // SEU PRÓPRIO documento (`MyProfileScreen`) — `memberNumber`/
    // `status`/`name` continuam exclusivos do Gestor.
    // Fase 6 (UC21): `fcmTokens` juntou-se à mesma lista — é o próprio
    // membro que regista o token do seu dispositivo (arrayUnion), nunca
    // o Gestor.
    // Fase 11 — a leitura era `belongsToTenant(tenantId)`: QUALQUER
    // aluno lia o documento de qualquer outro membro do ginásio, com
    // nome, telefone, email, NIF, morada, data de nascimento e contacto
    // de emergência. Encontrado a redigir a política de privacidade —
    // a frase "nenhum outro aluno vê os teus dados" era falsa, e a
    // forma de a tornar verdadeira era mudar o código, não o texto.
    //
    // Nenhum ecrã de Aluno precisa da lista de membros: os treze que a
    // usam são todos de Gestor ou de Instrutor. O Aluno só lê o seu
    // próprio documento (`memberProfileProvider`).
    //
    // Como nas subscrições: numa query de lista a regra é avaliada por
    // documento devolvido, por isso ler o próprio passa e listar todos
    // falha no primeiro alheio.
    match /tenants/{tenantId}/members/{memberId} {
      allow read: if isManager(tenantId)
        || isInstructor(tenantId)
        || (belongsToTenant(tenantId) && request.auth.uid == memberId);
      allow write: if isManager(tenantId);
      allow update: if belongsToTenant(tenantId)
        && request.auth.uid == memberId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['phone', 'email', 'updatedAt', 'fcmTokens']);

      // --- Avaliações físicas (Fase 8, UC04/UC14 fechado) ---
      // Histórica — cada avaliação nova é um documento novo, nunca
      // sobrescreve a anterior (o próprio ecrã só chama `add()` para
      // criar). Escrita direta do cliente: sem invariante
      // cross-documento, mesmo padrão de `attendance`. O PRÓPRIO
      // membro só lê (nunca escreve — só o Instrutor/Gestor avalia).
      // Fase 11 (RGPD) — `write` passou a exigir também o consentimento
      // do próprio membro. Ler continua livre para Instrutor/Gestor: se
      // o consentimento for retirado, o histórico já recolhido não
      // desaparece por magia — apaga-se com "Eliminar dados" (artigo
      // 17.º), que é uma ação explícita e auditável, não um efeito
      // lateral de mexer num interruptor.
      match /assessments/{assessmentId} {
        allow read: if belongsToTenant(tenantId)
          && (request.auth.uid == memberId || isManager(tenantId) || isInstructor(tenantId));
        allow write: if (isManager(tenantId) || isInstructor(tenantId))
          && hasHealthDataConsent(tenantId, memberId);
      }

      // --- Histórico de carga (Fase 8, UC16 fechado) ---
      // Só `create` — "nunca sobrescrever o histórico" é aplicado a
      // sério aqui, não só na UI: um `update`/`delete` deixaria
      // reescrever um registo já feito, o que o próprio use case
      // fechado proíbe explicitamente.
      // Fase 11 — duas mudanças, ambas exigidas pelo registo de treino:
      //
      // 1. O PRÓPRIO ALUNO passa a poder escrever. Antes só Instrutor e
      //    Gestor podiam, o que tornava impossível o aluno registar o
      //    seu treino — e num ginásio isso é o caso normal, não a
      //    exceção.
      //
      // 2. Deixou de exigir consentimento de dados de saúde. "Fez 10
      //    repetições com 60 kg" é o registo do SERVIÇO prestado — a
      //    base legal é a execução do contrato, como as marcações e as
      //    presenças. O artigo 9.º fica reservado ao que revela estado
      //    de saúde: composição corporal e pressão arterial, que
      //    continuam a exigir consentimento explícito em
      //    `assessments`.
      //
      //    [ADVOGADO] Esta é uma qualificação jurídica, não técnica, e
      //    está sinalizada em `legal/01-politica-de-privacidade.md`
      //    secção 5. A alternativa — manter o gate — tornaria o registo
      //    de treino indisponível a quem recusasse, o que é o núcleo do
      //    serviço contratado.
      //
      // `update` continua bloqueado: "nunca sobrescrever o histórico"
      // (UC16) vale para toda a gente, incluindo o próprio.
      //
      // `delete` abriu para UM caso, e só esse: registos criados por
      // uma série de treino (`sessionId` presente). Corrigir uma série
      // mal registada — 6 kg escritos em vez de 60 — apaga o registo
      // errado e cria outro, porque alterá-lo no lugar seria mesmo
      // reescrever histórico.
      //
      // O que isto NÃO abre: os registos criados pelo Instrutor ao
      // mudar a carga prescrita não têm `sessionId`, e continuam
      // imutáveis. A progressão que o UC16 protege é essa; um engano
      // de dedo registado há dois minutos não é progressão, é lixo que
      // fica no gráfico para sempre.
      match /loadHistory/{recordId} {
        allow read: if belongsToTenant(tenantId)
          && (request.auth.uid == memberId || isManager(tenantId) || isInstructor(tenantId));
        allow create: if belongsToTenant(tenantId)
          && (request.auth.uid == memberId
              || isManager(tenantId)
              || isInstructor(tenantId));
        allow delete: if belongsToTenant(tenantId)
          && (request.auth.uid == memberId
              || isManager(tenantId)
              || isInstructor(tenantId))
          && 'sessionId' in resource.data;
        allow update: if false;
      }

      // Fase 11 — sessões de treino: o que foi FEITO num dia.
      //
      // Escrita pelos três papéis, pela mesma razão: o aluno regista o
      // seu treino, e o instrutor ou o gestor registam por ele quando o
      // acompanham ao lado — que é como um estúdio com PT funciona.
      //
      // `delete` permitido para descartar uma sessão aberta por engano.
      // Uma sessão TERMINADA é histórico e não se apaga por aqui; para
      // isso existe o apagamento RGPD, que é uma ação deliberada.
      match /workoutSessions/{sessionId} {
        allow read: if belongsToTenant(tenantId)
          && (request.auth.uid == memberId || isManager(tenantId) || isInstructor(tenantId));
        allow create, update: if belongsToTenant(tenantId)
          && (request.auth.uid == memberId
              || isManager(tenantId)
              || isInstructor(tenantId));
        allow delete: if belongsToTenant(tenantId)
          && (request.auth.uid == memberId
              || isManager(tenantId)
              || isInstructor(tenantId))
          && resource.data.finishedAt == null;
      }

      // --- Plano de treino (Fase 8, UC13) ---
      // `currentLoad` é sempre o valor mais recente (espelha o
      // último `loadHistory`); o cliente (`TrainingPlanRepository`)
      // garante que os dois ficam coerentes através de um
      // `WriteBatch` — a Rule não valida essa coerência entre
      // coleções (exigiria `get()` ao histórico a cada escrita, sem
      // benefício real: só Instrutor/Gestor escrevem aqui na mesma).
      // Fase 11 — os TREINOS do plano ("Treino A — Costas"). Mesmas
      // permissões dos exercícios que contêm: o próprio membro lê o seu
      // plano, Instrutor e Gestor prescrevem.
      match /workouts/{workoutId} {
        allow read: if belongsToTenant(tenantId)
          && (request.auth.uid == memberId || isManager(tenantId) || isInstructor(tenantId));
        allow write: if isManager(tenantId) || isInstructor(tenantId);
      }

      match /planEntries/{entryId} {
        allow read: if belongsToTenant(tenantId)
          && (request.auth.uid == memberId || isManager(tenantId) || isInstructor(tenantId));
        allow write: if isManager(tenantId) || isInstructor(tenantId);
      }

      // --- Mensalidades (Fase 9, UC27 fechado) ---
      // Manager-only, mesmo para leitura (ao contrário de
      // assessments/loadHistory/planEntries, que o Instrutor também lê)
      // — o mockup coloca "pagamentos" explicitamente na secção
      // exclusiva do Gestor ("superset do Instrutor... mais gestão de
      // utilizadores, serviços e pagamentos"), nunca na do Instrutor. O
      // PRÓPRIO membro também lê (histórico das suas mensalidades).
      // `write` inclui `update`: corrigir um mês já registado é
      // esperado (Domain Model v1 §46: "append/update controlado"),
      // diferente de `loadHistory`, que é imutável de propósito.
      //
      // A cópia denormalizada em `members/{memberId}.currentPaymentStatus/
      // currentPaymentPeriod` (regra do match pai, `allow write: if
      // isManager`) fica coerente com este registo através de um
      // `WriteBatch` do lado do cliente (`FirebasePaymentRepository`),
      // mesmo raciocínio de `planEntries`/`loadHistory` acima — a Rule
      // não valida essa coerência entre documentos.
      match /paymentRecords/{recordId} {
        allow read: if belongsToTenant(tenantId)
          && (request.auth.uid == memberId || isManager(tenantId));
        allow write: if isManager(tenantId);
      }
    }

    // Fase 8 (revisão geral) — era `allow read, write: if
    // belongsToTenant`, ou seja QUALQUER aluno autenticado do tenant
    // podia ESCREVER no documento de qualquer instrutor/gestor:
    // desativá-lo (`status: inactive`, negação de serviço na prática,
    // já que `StaffDetailScreen` e o calendário filtram por isso),
    // alterar-lhe nome/email/dados pessoais, ou até criar um
    // `staff/{o-próprio-uid}`. Não era escalada de privilégios — os
    // roles vêm dos custom claims do token, nunca deste documento — mas
    // era uma lacuna real de autorização, exatamente a mesma que
    // `members` fechou na Fase 5 e que aqui ficou por fechar com o
    // argumento "só o Gestor mexe em staff hoje" (verdade na UI, não
    // imposta pelo servidor).
    //
    // Leitura mantém-se ampla no tenant: `BookTrainingScreen` (ecrã de
    // Aluno) mostra o nome do instrutor da sessão. Isso implica que os
    // dados pessoais do staff (telefone, NIF, morada) também ficam
    // legíveis por qualquer membro — as Rules do Firestore não filtram
    // por campo. Fica assinalado; fechá-lo a sério exigiria separar os
    // dados pessoais para uma subcoleção própria, que é uma mudança de
    // modelo de dados, não uma regra.
    // A leitura é ampla dentro do tenant de propósito: é daqui que sai
    // o NOME do instrutor no cartão de uma aula, que qualquer aluno vê.
    // Por isso mesmo, os dados pessoais deixaram de estar aqui — ver o
    // `match /private/` abaixo.
    match /tenants/{tenantId}/staff/{staffId} {
      allow read: if belongsToTenant(tenantId);
      allow write: if isManager(tenantId);

      // Última ronda — morada, NIF, data de nascimento e contacto de
      // emergência do staff estavam no documento acima, legível por
      // TODO o tenant: qualquer aluno conseguia ler o NIF e a morada
      // dos instrutores. É a mesma fuga que foi fechada em `members`
      // na Fase 11; o staff tinha ficado para trás.
      //
      // Escrita sempre `false`: passa por `createStaff`/
      // `updateStaffProfile` (Admin SDK), como o resto do perfil de
      // staff. O próprio lê os seus dados; o Gestor lê os de todos,
      // que é o que a ficha de staff precisa.
      match /private/{documentId} {
        allow read: if isManager(tenantId)
          || (belongsToTenant(tenantId) && request.auth.uid == staffId);
        allow write: if false;
      }
      // UC21 — o próprio staff regista o token FCM do seu dispositivo
      // (`registerFcmToken`, `arrayUnion`), tal como um membro faz no
      // seu documento. Só este campo.
      allow update: if belongsToTenant(tenantId)
        && request.auth.uid == staffId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['fcmTokens']);
    }

    // Fase 4: escrita restrita a Manager (era ampla desde a Fase 1,
    // quando ainda não guardava nada sensível). `config/bookingPolicy`
    // (`minCancellationNoticeHours`) é uma decisão de negócio do
    // Gestor, não algo que qualquer membro deva poder reescrever.
    match /tenants/{tenantId}/config/{configId} {
      allow read: if belongsToTenant(tenantId);
      allow write: if isManager(tenantId);
    }

    // --- Services (Fase 2, escrita liberada na Fase 3) ---
    // Leitura ampla dentro do tenant; escrita só Manager, agora que
    // `ManageServicesScreen` (Fase 3, UC26) existe. Mesmo padrão de
    // `plans` logo abaixo — escrita direta do cliente, sem Cloud
    // Function, porque não há nenhuma invariante cross-documento a
    // validar (criar/ativar/desativar um Service é uma escrita
    // isolada a UM documento).
    match /tenants/{tenantId}/services/{serviceId} {
      allow read: if belongsToTenant(tenantId);
      allow write: if isManager(tenantId);
    }

    // --- Modalities (Fase 6, Domain Model v1 §8-9) ---
    // Mesmo padrão exato de `services` — escrita direta do cliente,
    // sem invariante cross-documento (a lista `serviceIds` vive no
    // próprio documento da modalidade, ver `modality.dart`).
    match /tenants/{tenantId}/modalities/{modalityId} {
      allow read: if belongsToTenant(tenantId);
      allow write: if isManager(tenantId);
    }

    // --- Biblioteca de exercícios (Fase 8, UC15 fechado) ---
    // "Partilhada por todos os instrutores" — tenant-wide, sem dono.
    // Leitura ampla (o Aluno precisa de ver nome/vídeo dos exercícios
    // do seu próprio plano); escrita Manager OU Instrutor (ao
    // contrário de `services`/`modalities`/`plans`, que continuam
    // Manager-only — a biblioteca é uma ferramenta do dia a dia do
    // Instrutor, não uma decisão de gestão do negócio).
    match /tenants/{tenantId}/exercises/{exerciseId} {
      allow read: if belongsToTenant(tenantId);
      allow write: if isManager(tenantId) || isInstructor(tenantId);
    }

    // --- Sessions / Bookings (Fase 2; escrita fechada ao cliente na Fase 4) ---
    //
    // Até à Fase 3, a única escrita permitida a um cliente era o
    // próprio membro a atualizar `activeBookingCount` (+1/-1) dentro
    // das condições exatas de um booking/cancelamento — a transação
    // client-side original (`firebase_booking_repository.dart`, Fase
    // 2). A partir da Fase 4, `createBooking`/`cancelBooking` passaram
    // a Cloud Functions (Admin SDK — ver nota de arquitetura em
    // `createBooking.ts`): a validação do limite semanal de utilização
    // não dá para exprimir com a mesma robustez em Security Rules (teria
    // de cruzar o documento de `usage`, a `UsageRule` do Plan do
    // membro, etc.), o mesmo motivo que já tinha levado
    // `createSubscription` a ser Cloud Function na Fase 3.
    //
    // Fase 5: o Gestor volta a poder escrever aqui diretamente — criar
    // uma ocorrência ad-hoc ("só esta data") ou ajustar uma ocorrência
    // já gerada por uma série (hora/capacidade/instrutor/cancelar) sem
    // tocar na série. Mas `activeBookingCount` continua exclusivo das
    // Cloud Functions de booking (createBooking/cancelBooking/
    // generateRecurringOccurrences/assignMembersToOccurrence, todas
    // Admin SDK): `create` exige que nasça a 0, `update` exige que o
    // valor não mude nesta escrita — fecha a mesma lacuna já fechada na
    // Fase 4 ("um cliente malicioso podia, em teoria, enviar só o
    // incremento do contador"), agora também para um Manager.
    match /tenants/{tenantId}/sessionOccurrences/{occurrenceId} {
      allow read: if belongsToTenant(tenantId);
      allow create: if (isManager(tenantId)
          || instructorOwnsSession(tenantId, request.resource.data))
        && request.resource.data.activeBookingCount == 0;
      // Fase 6: `update` passou a exigir também que `status` não mude
      // — cancelar (UC18/UC10) precisa de cascatar para os bookings
      // ativos (libertar vaga + devolver usage), o que só a Cloud
      // Function `cancelOccurrenceForStudio` (Admin SDK) faz; sem esta
      // condição, um Manager podia "cancelar" com um update direto e
      // saltar a cascata por completo.
      allow update: if (isManager(tenantId)
          || (instructorOwnsSession(tenantId, resource.data)
              && instructorOwnsSession(tenantId, request.resource.data)))
        && request.resource.data.activeBookingCount == resource.data.activeBookingCount
        && request.resource.data.status == resource.data.status;
      // Continua `false`, e a tentativa de o abrir foi um erro que
      // vale a pena deixar escrito.
      //
      // A ideia era deixar o Gestor eliminar uma aula vazia — criada
      // por engano — em vez de a cancelar e a deixar no calendário para
      // sempre. O objetivo era bom; o sítio estava errado, por duas
      // razões que as Rules não conseguem cobrir:
      //
      //   1. `activeBookingCount == 0` NÃO significa que não há
      //      marcações: cancelar uma marcação põe `status: 'cancelled'`
      //      e deixa o documento. Apagar a aula deixava essas
      //      marcações órfãs, e o cliente não lhes pode tocar
      //      (`bookings` e `waitlist` são `write: false`).
      //   2. As aulas geradas por série têm id determinístico
      //      (`{seriesId}_{data}`). O cron da noite recriava-as com o
      //      MESMO id, e as órfãs voltavam a aparecer agarradas a elas.
      //
      // Passou para `deleteCatalogueEntry`, que apaga as subcoleções e
      // recusa aulas de série — para essas, cancelar é a única
      // operação que faz sentido.
      allow delete: if false;

      // Bookings continuam SEMPRE fora do alcance do cliente, mesmo
      // Manager — criar/atribuir passa sempre por createBooking/
      // assignMembersToOccurrence/generateRecurringOccurrences
      // (Admin SDK, ignora estas regras), nunca por escrita direta.
      // Fase 11 — a leitura era `belongsToTenant(tenantId)`, ou seja
      // qualquer aluno listava quem estava inscrito em cada aula. O
      // treino livre já fazia isto bem desde a Fase 7 ("Aluno vê só
      // contagem; Gestor e Instrutor veem nomes", UC09/UC17) e as aulas
      // ficaram para trás — a contagem pública vive em
      // `activeBookingCount`, no próprio documento da ocorrência, e é
      // tudo o que um Aluno precisa de ver.
      //
      // O Aluno continua a alcançar as SUAS marcações: por este match
      // quando as lê diretamente, e pelo match de collectionGroup mais
      // abaixo quando o ecrã "Minhas marcações" as procura em todas as
      // sessões de uma vez.
      match /bookings/{bookingId} {
        allow read: if isManager(tenantId)
          || isInstructor(tenantId)
          || (belongsToTenant(tenantId)
              && resource.data.memberId == request.auth.uid);
        allow write: if false;
      }

      // Fase 11 — lista de espera de uma sessão cheia.
      //
      // Mesma visibilidade das marcações: o aluno vê a SUA posição na
      // fila, o staff vê a fila toda. Saber quem mais está à espera não
      // serve de nada a um aluno e é informação sobre terceiros.
      //
      // Escrita sempre `false`: entrar na fila exige verificar
      // capacidade, marcação existente e elegibilidade — decisões que
      // não podem ficar do lado do cliente. Passa por `joinWaitlist` /
      // `leaveWaitlist`; a promoção automática é do Admin SDK.
      match /waitlist/{waitlistMemberId} {
        allow get: if isManager(tenantId)
          || isInstructor(tenantId)
          || (belongsToTenant(tenantId)
              && request.auth.uid == waitlistMemberId);
        allow list: if isManager(tenantId) || isInstructor(tenantId);
        allow write: if false;
      }

      // Presença (Fase 6, UC10-A) — documento isolado, sem contador
      // nem invariante cross-documento; ao contrário de bookings, não
      // precisa de Cloud Function. Manager OU Instrutor.
      match /attendance/{memberId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if isManager(tenantId) || isInstructor(tenantId);
      }
    }

    // --- Session Series (Fase 5, UC17/UC19) ---
    //
    // Escrita direta do cliente pelo Gestor — mesmo padrão de `plans`/
    // `services` logo abaixo: criar/editar/cancelar uma série é uma
    // escrita isolada a UM documento, sem nenhuma invariante
    // cross-documento a validar aqui (ao contrário de `createSubscription`
    // ou da geração de ocorrências, que continuam Cloud Function). A
    // materialização em `sessionOccurrences` e a auto-atribuição de
    // `preAssignedMemberIds` continuam sempre a passar por
    // `generateRecurringOccurrences`/`assignMembersToOccurrence`
    // (Admin SDK) — guardar a lista aqui não escreve bookings nenhuns
    // por si só.
    // Fase 11 — o Instrutor passou a poder criar e gerir as SUAS
    // séries. Antes era Manager-only, o que obrigava o Gestor a montar
    // o horário de toda a gente — e num estúdio onde cada instrutor
    // sabe as suas horas melhor do que ninguém, isso é um estrangulamento
    // sem razão de ser.
    //
    // `update`/`delete` avaliam a série QUE JÁ LÁ ESTÁ (`resource`) e a
    // que fica (`request.resource`): sem as duas, um instrutor pegava
    // numa série de um colega e reatribuía-a a si próprio.
    match /tenants/{tenantId}/sessionSeries/{seriesId} {
      allow read: if belongsToTenant(tenantId);
      allow create: if isManager(tenantId)
        || instructorOwnsSession(tenantId, request.resource.data);
      allow update: if isManager(tenantId)
        || (instructorOwnsSession(tenantId, resource.data)
            && instructorOwnsSession(tenantId, request.resource.data));
      allow delete: if isManager(tenantId);
    }

    // --- Usage tracking (Fase 4) ---
    //
    // `usage/{memberId}_{serviceId}_{period}` — read model derivado
    // (Firestore Data Model v1 §32/D13), escrito só por
    // `createBooking`/`cancelBooking`/`recalculateUsage` (Admin SDK).
    // Leitura ampla dentro do tenant: o próprio membro lê para mostrar
    // a barra "X/Y sessões esta semana" (Fase 4 story 7), e o Gestor
    // também precisa de a poder consultar.
    match /tenants/{tenantId}/usage/{usageId} {
      allow read: if belongsToTenant(tenantId);
      allow write: if false;
    }

    // --- Plans / PlanServices (Fase 3, UC26) ---
    //
    // Leitura ampla dentro do tenant (qualquer membro precisa de ver os
    // planos para, no futuro, os poder contratar/consultar); escrita
    // só para Manager. Ao contrário de `bookings`, isto é escrita
    // direta do cliente (`FirebasePlanRepository`), não passa por
    // Cloud Function — não há nenhuma invariante cross-documento a
    // validar aqui (ao contrário de `createSubscription`), por isso uma
    // regra simples de role chega.
    match /tenants/{tenantId}/plans/{planId} {
      allow read: if belongsToTenant(tenantId);
      allow write: if isManager(tenantId);

      match /services/{serviceId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if isManager(tenantId);
      }
    }

    // --- Subscriptions (Fase 3) ---
    //
    // Leitura ampla dentro do tenant: `isEligibleForService()`
    // (`firebase_subscription_repository.dart`) faz uma query direta a
    // esta coleção como o próprio membro, e um Manager também precisa
    // de a poder consultar. Escrita SEMPRE negada ao cliente — a única
    // via é a Cloud Function `createSubscription`, que corre com Admin
    // SDK e por isso ignora estas regras (ver nota de arquitetura em
    // `firebase_subscription_repository.dart` sobre porque a validação
    // "um serviço não pode estar em duas subscriptions ativas do mesmo
    // membro" não dá para exprimir aqui).
    // Fase 11 — a leitura era `belongsToTenant(tenantId)`, ou seja
    // QUALQUER aluno do ginásio lia as subscrições de todos os outros,
    // incluindo o `agreedPrice` — o preço que cada pessoa negociou.
    // Encontrado ao ligar o filtro de elegibilidade em "Marcar treino",
    // que passou a ler subscrições a partir do cliente do Aluno.
    //
    // Numa query de LISTA, a regra é avaliada por documento devolvido:
    // uma query filtrada por `memberId == uid` devolve só os próprios e
    // passa; uma sem esse filtro falha no primeiro documento alheio. É
    // exatamente o efeito pretendido, sem precisar de inspecionar a
    // query.
    //
    // Instrutor mantém leitura ampla: `watchEligibleMemberIds` (a
    // pré-atribuição de membros a uma sessão, Fase 5) consulta
    // subscrições por serviço, sem saber de quem são à partida.
    match /tenants/{tenantId}/subscriptions/{subscriptionId} {
      allow read: if isManager(tenantId)
        || isInstructor(tenantId)
        || (belongsToTenant(tenantId)
            && resource.data.memberId == request.auth.uid);
      allow write: if false;
    }

    // --- Leitura de "bookings" via collectionGroup (Fase 2) ---
    //
    // watchMyBookings() (firebase_booking_repository.dart) usa
    // `firestore.collectionGroup('bookings').where('memberId', ...)`
    // para mostrar as marcações do membro em TODAS as sessões, sem
    // saber de antemão em que sessionOccurrence cada uma está.
    //
    // O match aninhado acima (`tenants/{tenantId}/sessionOccurrences/
    // {occurrenceId}/bookings/{bookingId}`) só cobre pedidos a uma
    // profundidade EXATA — get/list numa subcoleção concreta. Uma
    // collectionGroup query não tem esse caminho fixo (varre TODAS as
    // subcoleções chamadas "bookings", a qualquer profundidade), e o
    // Firestore só autoriza esse tipo de pedido através de uma regra
    // com wildcard recursivo `{path=**}` dedicada — não reaproveita a
    // regra aninhada, mesmo que as condições sejam idênticas. Sem isto,
    // o pedido cai no bloqueio genérico do fim do ficheiro (foi o que
    // aconteceu: "false for 'list' @ L112" em vez de ser avaliado
    // contra a regra de `bookings` lá de cima).
    //
    // Só `read` (get+list) — criar/atualizar uma booking continua a
    // passar sempre pelo caminho completo e conhecido
    // (`sessionOccurrences/{occurrenceId}/bookings/{bookingId}`, nunca
    // por collectionGroup), por isso essa regra aninhada continua a ser
    // a única fonte de verdade para escrita; esta aqui não adiciona
    // nenhuma permissão de escrita nova.
    match /{path=**}/bookings/{bookingId} {
      // Duas tentativas anteriores tentaram extrair o tenantId do
      // próprio `path` capturado por {path=**} (path.size(), depois
      // path[0]/path[1]) — ambas deram erros de avaliação em runtime
      // (a API exata de indexação de `path` não está a comportar-se
      // como a documentação sugere, pelo menos nesta versão do
      // emulador). Em vez de continuar a adivinhar essa sintaxe,
      // simplifiquei para o que realmente importa aqui: só o dono da
      // marcação a pode ler. Isto não depende de path nenhum — só do
      // campo `memberId` do próprio documento vs. quem está
      // autenticado. É equivalente em termos de segurança ao
      // isolamento por tenant (um booking só é criado com
      // memberId == uid de quem o cria, dentro do próprio tenant desse
      // uid — agora garantido por `createBooking.ts`, Admin SDK, não
      // por uma regra `allow create` aqui — por isso nunca há forma de
      // um uid corresponder a um booking de outro tenant) e mais simples.
      allow read: if isSignedIn() && resource.data.memberId == request.auth.uid;
    }

    // --- Treino livre (Fase 7, UC09/UC17-A fechado) ---
    //
    // Estado da semana (`draft`/`suggested`/`published`) — a
    // sugestão automática nunca é visível ao Aluno até o Gestor
    // aprovar/publicar explicitamente ("nenhum aluno pode ver uma
    // grelha em estado 'sugerido'"). Escrita sempre `false`: mudar de
    // estado passa pelas Cloud Functions `suggestFreeTrainingSchedule`/
    // `publishFreeTrainingSchedule` (Admin SDK, ignoram estas regras).
    match /tenants/{tenantId}/freeTrainingSchedules/{weekId} {
      allow read: if isManager(tenantId)
        || (belongsToTenant(tenantId)
            && (resource == null || resource.data.status == 'published'));
      allow write: if false;

      // Um bloco horário reservável. Mesma visibilidade da semana-mãe
      // — Rules não herdam a condição do `match` pai automaticamente,
      // por isso `get()` explícito ao documento da semana. Escrita
      // direta pelo Gestor para montar a grelha antes de publicar
      // (mesmo padrão de `sessionOccurrences` ad-hoc, Fase 5):
      // `activeBookingCount` continua exclusivo das Cloud Functions de
      // booking (create exige nascer a 0, update exige não mudar nesta
      // escrita).
      //
      // Fase 8 (auditoria funcional, UC17-A fechado) — `delete` deixa
      // de ser sempre `false`: passa a ser permitido só ANTES de a
      // semana ser publicada (`status != 'published'`) e só se o bloco
      // não tiver ninguém marcado (`activeBookingCount == 0` — defesa
      // extra, mesmo que na prática marcar exija a semana já
      // publicada, `bookFreeTrainingSlot.ts`). Depois de publicada, um
      // bloco só pode ser esvaziado (`updateSlot`/capacidade), nunca
      // apagado — mesmo espírito de `sessionOccurrences`, que também
      // nunca permite `delete`.
      match /slots/{slotId} {
        allow read: if isManager(tenantId)
          || (belongsToTenant(tenantId)
              && freeTrainingWeekPublished(tenantId, weekId));
        allow create: if isManager(tenantId) && request.resource.data.activeBookingCount == 0;
        allow update: if isManager(tenantId)
          && request.resource.data.activeBookingCount == resource.data.activeBookingCount;
        // A condição `!freeTrainingWeekPublished` saiu: depois de
        // publicar, um bloco vazio só podia ir a capacidade 0 e ficava
        // na grelha a dizer "0/0" — visível aos alunos, sem servir para
        // nada. O que protege continua a proteger: sem ninguém
        // inscrito, apagar não liberta marcação nenhuma.
        allow delete: if isManager(tenantId)
          && resource.data.activeBookingCount == 0;

        // UC09/UC17 fechado — "Aluno vê só contagem; Gestor e
        // Instrutor veem nomes". A contagem já vive em
        // `activeBookingCount` (público, herda a leitura do slot); os
        // NOMES só existem lendo os documentos de booking, por isso é
        // aqui que a diferença de visibilidade tem de ser aplicada a
        // sério, não só escondida na UI: um Aluno só consegue `get` a
        // PRÓPRIA marcação (nunca `list`, nunca a de outro membro por
        // id); Instrutor/Gestor conseguem listar todas. Escrita sempre
        // `false` — passa por `bookFreeTrainingSlot`/
        // `cancelFreeTrainingBooking`/`assignMembersToFreeTrainingSlot`.
        match /bookings/{bookingId} {
          allow get: if isManager(tenantId) || isInstructor(tenantId)
            || (belongsToTenant(tenantId) && resource.data.memberId == request.auth.uid);
          allow list: if isManager(tenantId) || isInstructor(tenantId);
          allow write: if false;
        }

        // UC10-A fechado — "o Gestor (NÃO o Instrutor, que só tem
        // leitura sobre o treino livre) pode também registar presença/
        // falta nos horários de treino livre". Ao contrário de
        // `sessionOccurrences/attendance` (Fase 6, Manager OU
        // Instrutor), aqui é Manager-only.
        match /attendance/{memberId} {
          allow read: if isManager(tenantId) || isInstructor(tenantId);
          allow write: if isManager(tenantId);
        }
      }
    }

    // Tudo o resto fica bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
