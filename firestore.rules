rules_version = '2';

// Fase 1 — isolamento entre tenants (Platform Foundation §7).
// Fase 2 — regras específicas de booking (contador de vagas + ownership).
//
// A matriz fina de autorização por role (o que um Instructor pode
// fazer vs. um Manager, etc.) continua a ser trabalho do documento
// "06 — Security & Business Rules" e das fases 3+. Até lá, dentro do
// próprio tenant, qualquer utilizador autenticado tem leitura/escrita
// ampla — EXCETO em sessionOccurrences/bookings, onde a Fase 2 exige
// regras mais apertadas (não dá para ter aqui uma regra ampla que
// cubra tudo: no Firestore, se QUALQUER regra que faça match permitir
// a operação, ela é permitida — por isso sessionOccurrences/bookings
// têm de ficar FORA do wildcard genérico, não só "sobrepostas" por uma
// regra mais restrita).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function belongsToTenant(tenantId) {
      return isSignedIn() && request.auth.token.tenantId == tenantId;
    }

    // Fase 3 — primeira regra que distingue Manager de outros roles.
    // `roles` é um array nos custom claims (mesmo formato usado pelo
    // `requireManager()` das Cloud Functions — ver
    // `firebase/functions/src/lib/callerContext.ts`), por isso o
    // próprio token já traz esta informação sem precisar de nenhum
    // `get()` extra a Firestore.
    function isManager(tenantId) {
      return belongsToTenant(tenantId) && 'manager' in request.auth.token.roles;
    }

    // Sonda de diagnóstico da Fase 0. Não faz parte do modelo de negócio.
    match /_diagnostics/{docId} {
      allow read, write: if true;
    }

    // --- Dados de configuração/identidade do tenant (Fase 1) ---
    // Leitura/escrita ampla para qualquer utilizador do próprio tenant.
    // Ver nota no topo do ficheiro sobre porque isto não pode incluir
    // sessionOccurrences/bookings.

    match /tenants/{tenantId} {
      allow read, write: if belongsToTenant(tenantId);
    }

    // Fase 5 (UC02) — até aqui, `allow read, write: if belongsToTenant`
    // deixava QUALQUER membro autenticado do tenant escrever no
    // documento de QUALQUER OUTRO membro (incluindo `memberNumber`/
    // `status`) — nunca explorado por nenhum ecrã, mas uma lacuna real
    // de autorização, não só de UI. Escrita ampla continua só para
    // Manager; o próprio membro só pode atualizar `phone`/`email` no
    // SEU PRÓPRIO documento (`MyProfileScreen`) — `memberNumber`/
    // `status`/`name` continuam exclusivos do Gestor.
    match /tenants/{tenantId}/members/{memberId} {
      allow read: if belongsToTenant(tenantId);
      allow write: if isManager(tenantId);
      allow update: if belongsToTenant(tenantId)
        && request.auth.uid == memberId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['phone', 'email', 'updatedAt']);
    }

    match /tenants/{tenantId}/staff/{staffId} {
      allow read, write: if belongsToTenant(tenantId);
    }

    // Fase 4: escrita restrita a Manager (era ampla desde a Fase 1,
    // quando ainda não guardava nada sensível). `config/bookingPolicy`
    // (`minCancellationNoticeHours`) é uma decisão de negócio do
    // Gestor, não algo que qualquer membro deva poder reescrever.
    match /tenants/{tenantId}/config/{configId} {
      allow read: if belongsToTenant(tenantId);
      allow write: if isManager(tenantId);
    }

    // --- Services (Fase 2, escrita liberada na Fase 3) ---
    // Leitura ampla dentro do tenant; escrita só Manager, agora que
    // `ManageServicesScreen` (Fase 3, UC26) existe. Mesmo padrão de
    // `plans` logo abaixo — escrita direta do cliente, sem Cloud
    // Function, porque não há nenhuma invariante cross-documento a
    // validar (criar/ativar/desativar um Service é uma escrita
    // isolada a UM documento).
    match /tenants/{tenantId}/services/{serviceId} {
      allow read: if belongsToTenant(tenantId);
      allow write: if isManager(tenantId);
    }

    // --- Sessions / Bookings (Fase 2; escrita fechada ao cliente na Fase 4) ---
    //
    // Até à Fase 3, a única escrita permitida a um cliente era o
    // próprio membro a atualizar `activeBookingCount` (+1/-1) dentro
    // das condições exatas de um booking/cancelamento — a transação
    // client-side original (`firebase_booking_repository.dart`, Fase
    // 2). A partir da Fase 4, `createBooking`/`cancelBooking` passaram
    // a Cloud Functions (Admin SDK — ver nota de arquitetura em
    // `createBooking.ts`): a validação do limite semanal de utilização
    // não dá para exprimir com a mesma robustez em Security Rules (teria
    // de cruzar o documento de `usage`, a `UsageRule` do Plan do
    // membro, etc.), o mesmo motivo que já tinha levado
    // `createSubscription` a ser Cloud Function na Fase 3.
    //
    // Fase 5: o Gestor volta a poder escrever aqui diretamente — criar
    // uma ocorrência ad-hoc ("só esta data") ou ajustar uma ocorrência
    // já gerada por uma série (hora/capacidade/instrutor/cancelar) sem
    // tocar na série. Mas `activeBookingCount` continua exclusivo das
    // Cloud Functions de booking (createBooking/cancelBooking/
    // generateRecurringOccurrences/assignMembersToOccurrence, todas
    // Admin SDK): `create` exige que nasça a 0, `update` exige que o
    // valor não mude nesta escrita — fecha a mesma lacuna já fechada na
    // Fase 4 ("um cliente malicioso podia, em teoria, enviar só o
    // incremento do contador"), agora também para um Manager.
    match /tenants/{tenantId}/sessionOccurrences/{occurrenceId} {
      allow read: if belongsToTenant(tenantId);
      allow create: if isManager(tenantId)
        && request.resource.data.activeBookingCount == 0;
      allow update: if isManager(tenantId)
        && request.resource.data.activeBookingCount == resource.data.activeBookingCount;
      allow delete: if false;

      // Bookings continuam SEMPRE fora do alcance do cliente, mesmo
      // Manager — criar/atribuir passa sempre por createBooking/
      // assignMembersToOccurrence/generateRecurringOccurrences
      // (Admin SDK, ignora estas regras), nunca por escrita direta.
      match /bookings/{bookingId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if false;
      }
    }

    // --- Session Series (Fase 5, UC17/UC19) ---
    //
    // Escrita direta do cliente pelo Gestor — mesmo padrão de `plans`/
    // `services` logo abaixo: criar/editar/cancelar uma série é uma
    // escrita isolada a UM documento, sem nenhuma invariante
    // cross-documento a validar aqui (ao contrário de `createSubscription`
    // ou da geração de ocorrências, que continuam Cloud Function). A
    // materialização em `sessionOccurrences` e a auto-atribuição de
    // `preAssignedMemberIds` continuam sempre a passar por
    // `generateRecurringOccurrences`/`assignMembersToOccurrence`
    // (Admin SDK) — guardar a lista aqui não escreve bookings nenhuns
    // por si só.
    match /tenants/{tenantId}/sessionSeries/{seriesId} {
      allow read: if belongsToTenant(tenantId);
      allow write: if isManager(tenantId);
    }

    // --- Usage tracking (Fase 4) ---
    //
    // `usage/{memberId}_{serviceId}_{period}` — read model derivado
    // (Firestore Data Model v1 §32/D13), escrito só por
    // `createBooking`/`cancelBooking`/`recalculateUsage` (Admin SDK).
    // Leitura ampla dentro do tenant: o próprio membro lê para mostrar
    // a barra "X/Y sessões esta semana" (Fase 4 story 7), e o Gestor
    // também precisa de a poder consultar.
    match /tenants/{tenantId}/usage/{usageId} {
      allow read: if belongsToTenant(tenantId);
      allow write: if false;
    }

    // --- Plans / PlanServices (Fase 3, UC26) ---
    //
    // Leitura ampla dentro do tenant (qualquer membro precisa de ver os
    // planos para, no futuro, os poder contratar/consultar); escrita
    // só para Manager. Ao contrário de `bookings`, isto é escrita
    // direta do cliente (`FirebasePlanRepository`), não passa por
    // Cloud Function — não há nenhuma invariante cross-documento a
    // validar aqui (ao contrário de `createSubscription`), por isso uma
    // regra simples de role chega.
    match /tenants/{tenantId}/plans/{planId} {
      allow read: if belongsToTenant(tenantId);
      allow write: if isManager(tenantId);

      match /services/{serviceId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if isManager(tenantId);
      }
    }

    // --- Subscriptions (Fase 3) ---
    //
    // Leitura ampla dentro do tenant: `isEligibleForService()`
    // (`firebase_subscription_repository.dart`) faz uma query direta a
    // esta coleção como o próprio membro, e um Manager também precisa
    // de a poder consultar. Escrita SEMPRE negada ao cliente — a única
    // via é a Cloud Function `createSubscription`, que corre com Admin
    // SDK e por isso ignora estas regras (ver nota de arquitetura em
    // `firebase_subscription_repository.dart` sobre porque a validação
    // "um serviço não pode estar em duas subscriptions ativas do mesmo
    // membro" não dá para exprimir aqui).
    match /tenants/{tenantId}/subscriptions/{subscriptionId} {
      allow read: if belongsToTenant(tenantId);
      allow write: if false;
    }

    // --- Leitura de "bookings" via collectionGroup (Fase 2) ---
    //
    // watchMyBookings() (firebase_booking_repository.dart) usa
    // `firestore.collectionGroup('bookings').where('memberId', ...)`
    // para mostrar as marcações do membro em TODAS as sessões, sem
    // saber de antemão em que sessionOccurrence cada uma está.
    //
    // O match aninhado acima (`tenants/{tenantId}/sessionOccurrences/
    // {occurrenceId}/bookings/{bookingId}`) só cobre pedidos a uma
    // profundidade EXATA — get/list numa subcoleção concreta. Uma
    // collectionGroup query não tem esse caminho fixo (varre TODAS as
    // subcoleções chamadas "bookings", a qualquer profundidade), e o
    // Firestore só autoriza esse tipo de pedido através de uma regra
    // com wildcard recursivo `{path=**}` dedicada — não reaproveita a
    // regra aninhada, mesmo que as condições sejam idênticas. Sem isto,
    // o pedido cai no bloqueio genérico do fim do ficheiro (foi o que
    // aconteceu: "false for 'list' @ L112" em vez de ser avaliado
    // contra a regra de `bookings` lá de cima).
    //
    // Só `read` (get+list) — criar/atualizar uma booking continua a
    // passar sempre pelo caminho completo e conhecido
    // (`sessionOccurrences/{occurrenceId}/bookings/{bookingId}`, nunca
    // por collectionGroup), por isso essa regra aninhada continua a ser
    // a única fonte de verdade para escrita; esta aqui não adiciona
    // nenhuma permissão de escrita nova.
    match /{path=**}/bookings/{bookingId} {
      // Duas tentativas anteriores tentaram extrair o tenantId do
      // próprio `path` capturado por {path=**} (path.size(), depois
      // path[0]/path[1]) — ambas deram erros de avaliação em runtime
      // (a API exata de indexação de `path` não está a comportar-se
      // como a documentação sugere, pelo menos nesta versão do
      // emulador). Em vez de continuar a adivinhar essa sintaxe,
      // simplifiquei para o que realmente importa aqui: só o dono da
      // marcação a pode ler. Isto não depende de path nenhum — só do
      // campo `memberId` do próprio documento vs. quem está
      // autenticado. É equivalente em termos de segurança ao
      // isolamento por tenant (um booking só é criado com
      // memberId == uid de quem o cria, dentro do próprio tenant desse
      // uid — agora garantido por `createBooking.ts`, Admin SDK, não
      // por uma regra `allow create` aqui — por isso nunca há forma de
      // um uid corresponder a um booking de outro tenant) e mais simples.
      allow read: if isSignedIn() && resource.data.memberId == request.auth.uid;
    }

    // Tudo o resto fica bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
