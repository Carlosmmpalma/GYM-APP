rules_version = '2';

// Regras da Fase 1 — isolamento entre tenants (Platform Foundation §7).
//
// Objetivo ÚNICO desta fase: "um utilizador só consegue aceder aos
// dados do seu próprio tenant" (guia-desenvolvimento.md). A matriz fina
// de autorização por role (o que um Instructor pode fazer vs. um
// Manager, ownership de documentos, etc.) é trabalho do documento
// "06 — Security & Business Rules" e das fases 3+ — de propósito NÃO
// está aqui ainda. Qualquer utilizador autenticado do tenant correto
// tem, por agora, acesso de leitura/escrita a todo o seu tenant.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function belongsToTenant(tenantId) {
      return isSignedIn() && request.auth.token.tenantId == tenantId;
    }

    // Sonda de diagnóstico da Fase 0 (ver lib/infrastructure/firebase/
    // firebase_ping_repository.dart). Não faz parte do modelo de negócio;
    // fica deliberadamente aberta só para o "hello world".
    match /_diagnostics/{docId} {
      allow read, write: if true;
    }

    // Isolamento por tenant: só quem tem request.auth.token.tenantId
    // igual ao tenantId do path é que sequer entra aqui. Isto cobre
    // tenants/{tenantId} (config do tenant) e todas as subcollections
    // (members, staff, ...), incluindo as que ainda não existem —
    // {document=**} é recursivo.
    match /tenants/{tenantId}/{document=**} {
      allow read, write: if belongsToTenant(tenantId);
    }

    // Tudo o resto (paths fora de tenants/{tenantId}/... e fora de
    // _diagnostics/) fica bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
