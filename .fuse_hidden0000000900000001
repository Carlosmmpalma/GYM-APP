 do tenant (Fase 1) ---\n    // Leitura/escrita ampla para qualquer utilizador do próprio tenant.\n    // Ver nota no topo do ficheiro sobre porque isto não pode incluir\n    // sessionOccurrences/bookings.\n\n    match /tenants/{tenantId} {\n      allow read, write: if belongsToTenant(tenantId);\n    }\n\n    match /tenants/{tenantId}/members/{memberId} {\n      allow read, write: if belongsToTenant(tenantId);\n    }\n\n    match /tenants/{tenantId}/staff/{staffId} {\n      allow read, write: if belongsToTenant(tenantId);\n    }\n\n    // Fase 4: escrita restrita a Manager (era ampla desde a Fase 1,\n    // quando ainda não guardava nada sensível). `config/bookingPolicy`\n    // (`minCancellationNoticeHours`) é uma decisão de negócio do\n    // Gestor, não algo que qualquer membro deva poder reescrever.\n    match /tenants/{tenantId}/config/{configId} {\n      allow read: if belongsToTenant(tenantId);\n      allow write: if isManager(tenantId);\n    }\n\n    // --- Services (Fase 2, escrita liberada na Fase 3) ---\n    // Leitura ampla dentro do tenant; escrita só Manager, agora que\n    // `ManageServicesScreen` (Fase 3, UC26) existe. Mesmo padrão de\n    // `plans` logo abaixo — escrita direta do cliente, sem Cloud\n    // Function, porque não há nenhuma invariante cross-documento a\n    // validar (criar/ativar/desativar um Service é uma escrita\n    // isolada a UM documento).\n    match /tenants/{tenantId}/services/{serviceId} {\n      allow read: if belongsToTenant(tenantId);\n      allow write: if isManager(tenantId);\n    }\n\n    // --- Sessions / Bookings (Fase 2; escrita fechada ao cliente na Fase 4) ---\n    //\n    // Até à Fase 3, a única escrita permitida a um cliente era o\n    // próprio membro a atualizar `activeBookingCount` (+1/-1) dentro\n    // das condições exatas de um booking/cancelamento — a transação\n    // client-side original (`firebase_booking_repository.dart`, Fase\n    // 2). A partir da Fase 4, `createBooking`/`cancelBooking` passaram\n    // a Cloud Functions (Admin SDK — ver nota de arquitetura em\n    // `createBooking.ts`): a validação do limite semanal de utilização\n    // não dá para exprimir com a mesma robustez em Security Rules (teria\n    // de cruzar o documento de `usage`, a `UsageRule` do Plan do\n    // membro, etc.), o mesmo motivo que já tinha levado\n    // `createSubscription` a ser Cloud Function na Fase 3.\n    //\n    // Consequência: leitura continua ampla (mostrar vagas/marcações a\n    // qualquer membro do tenant), mas ESCRITA fica `false` para o\n    // cliente em ambos — só a Cloud Function (Admin SDK, ignora estas\n    // regras) escreve. Isto fecha, de vez, a lacuna que já estava\n    // documentada (e aceite) no código antigo: \"um cliente malicioso\n    // podia, em teoria, enviar só o incremento do contador sem criar o\n    // booking\" — agora não consegue, porque não consegue escrever\n    // nenhum dos dois diretamente.\n    match /tenants/{tenantId}/sessionOccurrences/{occurrenceId} {\n      allow read: if belongsToTenant(tenantId);\n      allow write: if false;\n\n      match /bookings/{bookingId} {\n        allow read: if belongsToTenant(tenantId);\n        allow write: if false;\n      }\n    }\n\n    // --- Usage tracking (Fase 4) ---\n    //\n    // `usage/{memberId}_{serviceId}_{period}` — read model derivado\n    // (Firestore Data Model v1 §32/D13), escrito só por\n    // `createBooking`/`cancelBooking`/`recalculateUsage` (Admin SDK).\n    // Leitura ampla dentro do tenant: o próprio membro lê para mostrar\n    // a barra \"X/Y sessões esta semana\" (Fase 4 story 7), e o Gestor\n    // também precisa de a poder consultar.\n    match /tenants/{tenantId}/usage/{usageId} {\n      allow read: if belongsToTenant(tenantId);\n      allow write: if false;\n    }\n\n    // --- Plans / PlanServices (Fase 3, UC26) ---\n    //\n    // Leitura ampla dentro do tenant (qualquer membro precisa de ver os\n    // planos para, no futuro, os poder contratar/consultar)